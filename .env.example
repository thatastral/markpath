# A local path is used by default. Do not commit a real database or secrets.
MARKPATH_DB_PATH=./data/markpath.sqlite
# Replace in any shared or deployed environment.
MARKPATH_SESSION_SECRET=replace-with-a-long-random-secret
# Integration modes are displayed accurately by later slices.
GITHUB_MODE=fixture
FIGMA_MODE=fixture
CANVA_MODE=disabled
# The address teammates open for approval links (for example https://markpath.yourcompany.com). Empty = the address the agents use.
MARKPATH_PUBLIC_URL=
SWITCH_BASE_URL=
SWITCH_AGENT_TOKEN=
MARKPATH_AGENT_TOKEN=
# Per-agent tokens: run `npm run agents:tokens` to generate them. Never commit real values.
MARKPATH_AGENT_TOKEN_DIRECTOR=
MARKPATH_AGENT_TOKEN_DESIGN=
MARKPATH_AGENT_TOKEN_IMPLEMENTATION=
MARKPATH_AGENT_TOKEN_QA=
# Figma plugin token (also written by `npm run agents:tokens`).
MARKPATH_PLUGIN_TOKEN=
# GitHub OAuth app Client ID (public; Device Flow enabled). No client secret is needed.
GITHUB_CLIENT_ID=

# Local-only test account used for end-to-end checks on localhost (never on a hosted site): e2e-owner@markpath.test / local-e2e-pass-2026
